#version 450
//
// Acceptance kernel for specialization constants: the workgroup size and three
// typed constants are all fixed when the pipeline is built, not at dispatch.
//
//   dst[i] = NEGATE ? -(src[i] * FACTOR + OFFSET) : src[i] * FACTOR + OFFSET
//
// Compiled to specialized.spv, which is committed next to this file so the test
// suite can dispatch it on hosts without a shader compiler:
//
//   glslangValidator -V --target-env vulkan1.0 -S comp -o specialized.spv specialized.comp
//
layout(local_size_x_id = 0, local_size_x = 1) in;

layout(constant_id = 1) const int OFFSET = 0;
layout(constant_id = 2) const float FACTOR = 1.0;
layout(constant_id = 3) const bool NEGATE = false;

layout(std430, set = 0, binding = 0) readonly buffer Source {
    float value[];
} src;

layout(std430, set = 0, binding = 1) writeonly buffer Destination {
    float value[];
} dst;

layout(push_constant) uniform Params {
    uint count;
} params;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index < params.count) {
        float scaled = src.value[index] * FACTOR + float(OFFSET);
        dst.value[index] = NEGATE ? -scaled : scaled;
    }
}
